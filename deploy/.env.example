# .env.api  (prod)
Anthropic__ApiKey=
# Per-source keys (ClaudeClient.ResolveClient, routed by the caller's
# X-Source header) — optional, blank-guarded back to Anthropic__ApiKey
# above if unset. Lets the Anthropic console split cost by caller instead
# of everything billing to the default key.
Anthropic__ApiKeys__ingest=
Anthropic__ApiKeys__mailbot=
ApiKey=
MongoDB__ConnectionString=
MongoDB__DatabaseName=
MongoDB__ProfileDatabase=
# Who this instance serves. Fixed = one user, id from the value below.
# SET IT EXPLICITLY: leaving these out falls back to the appsettings default
# (11111111-1111-1111-1111-111111111111), which then silently becomes the
# permanent owner of every pre-multi-user document on first boot. The id is
# SET-ONCE — changing it later orphans everything. See deploy/README.md.
Identity__Mode=Fixed
Identity__FixedUserId=
# Per-agent Hebrew narrative output (PromptOptions.HebrewOutput) — unset/false
# on both keys means English (the class default), same as leaving them out
# entirely. Only these two agents are configurable this way; every other
# narrative agent (Evaluator included) always writes English regardless of
# these — see PromptOptions.cs. Leave both unset on .env.demo-api so the
# public demo stays English.
Prompts__HebrewOutput__WhyWorkHere=
Prompts__HebrewOutput__CompanySummary=

# .env.scraper (prod)
MONGODB_CONNECTION_STRING=
MONGODB_DATABASE_NAME=
MongoDB__ProfileDatabase=
# Mirror of the API's identity block — the scraper resolves the same user the
# same way (app/identity.py) and refuses to start if this disagrees with
# itself. Same value as Identity__FixedUserId above.
IDENTITY_MODE=fixed
IDENTITY_FIXED_USER_ID=
OPENAI_API_KEY=

# .env.client (prod)
API_URL=http://api:8080
SCRAPER_URL=http://scraper:8080

# .env.demo-api
Anthropic__ApiKey=
CorsOrigins=https://nextrole.cloud
# Cookie = the multi-user instance: every visitor gets a uid cookie on their
# first request and owns what they create (docs/multi-user.md). Fixed + the
# id below is the other option, and is what DemoMode=true expects — a seeded
# read-only instance has one owner for its fictional data. Set one or the
# other deliberately; the two deployments differ by configuration only.
Identity__Mode=Fixed
Identity__FixedUserId=
DemoMode=true
MongoDB__ConnectionString=
MongoDB__DatabaseName=
MongoDB__ProfileDatabase=
# Session lifetime in days, sliding. Matches the lifetime the pre-sessions
# cookie had, so introducing sessions does not start expiring people.
Identity__SessionLifetimeDays=365
# CUTOVER, TIME-LIMITED. Honours a pre-sessions cookie (the bare userId) once,
# by minting a real session bound to that same userId — without it every
# existing visitor is orphaned on the deploy that introduces sessions.
#
# It necessarily re-opens what sessions close: present a userId, get a session.
# Safe for anonymous ids (122 random bits); a LINKED account is refused, so the
# ClaimUserId target below cannot be taken this way.
#
# Turn it off on evidence, not on a reminder: UserSession.FromLegacyCookie
# records which sessions came through here. Target three months.
Identity__AcceptLegacyGuidCookie=true
#
# --- Google sign-in (docs/auth.md). Cookie mode only: the endpoints 404 under
# --- Fixed, where identity comes from configuration and no cookie is issued.
# Leave ClientId/ClientSecret blank to disable sign-in entirely — the API still
# starts, /api/auth/* 404s, and the client hides the link via /api/auth/me.
Google__ClientId=
Google__ClientSecret=
# Must match an Authorized redirect URI on the OAuth client EXACTLY, including
# scheme, host, port and path.
Google__RedirectUri=https://nextrole.cloud/api/auth/google/callback
# Where the browser lands afterwards. "/" is right in production, where one
# origin serves client and API.
Google__PostSignInRedirect=/
#
# ONE-SHOT MIGRATION. ALL THREE OR NONE — the API REFUSES TO START on a partial
# set, and refuses to start once ClaimExpiresAt has passed.
#
# ClaimUserId  the pre-auth account being handed over.
# ClaimEmail   the ONLY Google account allowed to take it. Without it the
#              account goes to whoever signs in first, which on a public
#              instance is an account takeover waiting for a stranger.
#              Google must report the address as verified.
# ClaimExpiresAt  when the offer stops existing, absolute UTC
#              (yyyy-MM-dd or yyyy-MM-ddTHH:mm:ssZ, parsed strictly).
#              A hatch that closes when someone remembers stays open.
#
# Delete all three once the migration is done. The expiry will force it.
Google__ClaimUserId=
Google__ClaimEmail=
Google__ClaimExpiresAt=

# .env.demo-scraper
IDENTITY_MODE=fixed
IDENTITY_FIXED_USER_ID=
DEMO_MODE=true
# Mirror of the API's Identity__AcceptLegacyGuidCookie. Turn both off together:
# the scraper honours a pre-sessions cookie read-only and never mints.
ACCEPT_LEGACY_GUID_COOKIE=true
MONGODB_CONNECTION_STRING=
# MUST match the API's MongoDB__DatabaseName above. In Cookie mode the scraper
# resolves sessions by reading that database's "sessions" collection directly
# (docs/auth.md), so a mismatch means every scraper request 401s — or, worse,
# resolves against another instance's sessions. Nothing checks this.
MONGODB_DATABASE_NAME=
MongoDB__ProfileDatabase=
OPENAI_API_KEY=

# .env.demo-client
API_URL=http://demo-api:8080
SCRAPER_URL=http://demo-scraper:8080

# .env.mailbot
Anthropic__ApiKey=
