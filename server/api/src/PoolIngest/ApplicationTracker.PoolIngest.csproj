<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ApplicationTracker.PoolIngest</AssemblyName>
    <RootNamespace>ApplicationTracker.PoolIngest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Unlike the mailbot, which reaches the API entirely over HTTP and so has
         no project references at all, this exists in .NET precisely to use the
         pool's models and Mongo layer directly. That dependency is why it lives
         here beside DbCopy and Seeder rather than as a standalone service
         (docs/scraper-slimming.md). -->
    <ProjectReference Include="../Core/ApplicationTracker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="3.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.3" />
  </ItemGroup>

</Project>
