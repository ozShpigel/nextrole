# One deployment: nextrole.cloud. These four files live in /srv/nextrole and are
# the only manual configuration on the box -- nothing here is in the repo, so a
# `git pull` will not fix a mistake in them.
#
# Until the teardown there were seven, because the same images ran twice: once
# as api/scraper/client for private.nextrole.cloud and once as
# demo-api/demo-scraper/demo-client for the public site. The second set has been
# renamed to api/scraper/web and the first retired.

# .env.api
Anthropic__ApiKey=
# Per-source keys (ClaudeClient.ResolveClient, routed by the caller's
# X-Source header) -- optional, blank-guarded back to Anthropic__ApiKey
# above if unset. Lets the Anthropic console split cost by caller instead
# of everything billing to the default key.
Anthropic__ApiKeys__ingest=
Anthropic__ApiKeys__mailbot=
CorsOrigins=https://nextrole.cloud
MongoDB__ConnectionString=
MongoDB__DatabaseName=
MongoDB__ProfileDatabase=
# Cookie = every visitor gets a session and owns what they create
# (docs/multi-user.md). Fixed + Identity__FixedUserId is the other option and
# is what the golden-set eval CLIs need -- they call identity.instance_identity,
# which RAISES on a Cookie instance rather than guessing a user. Fixed is not
# retired; it simply has no hosted deployment any more. Run it locally.
Identity__Mode=Cookie
# Session lifetime in days, sliding. Matches the lifetime the pre-sessions
# cookie had, so introducing sessions did not start expiring people.
Identity__SessionLifetimeDays=365
# CUTOVER, TIME-LIMITED. Honours a pre-sessions cookie (the bare userId) once,
# by minting a real session bound to that same userId.
#
# It necessarily re-opens what sessions close: present a userId, get a session.
# Safe for anonymous ids (122 random bits); a LINKED account is refused.
#
# Turn it off on evidence, not on a reminder: UserSession.FromLegacyCookie
# records which sessions came through here. Target three months.
Identity__AcceptLegacyGuidCookie=true
#
# --- Google sign-in (docs/auth.md). Cookie mode only: the endpoints 404 under
# --- Fixed, where identity comes from configuration and no cookie is issued.
# Leave ClientId/ClientSecret blank to disable sign-in entirely -- the API still
# starts, /api/auth/* 404s, and the client hides the link via /api/auth/me.
Google__ClientId=
Google__ClientSecret=
# Must match an Authorized redirect URI on the OAuth client EXACTLY, including
# scheme, host, port and path.
Google__RedirectUri=https://nextrole.cloud/api/auth/google/callback
# Where the browser lands afterwards. "/" is right in production, where one
# origin serves client and API.
Google__PostSignInRedirect=/
#
# ONE-SHOT MIGRATION. ALL THREE OR NONE -- the API REFUSES TO START on a partial
# set, and refuses to start once ClaimExpiresAt has passed. Leave blank unless a
# migration is actually in flight; the expiry is what forces the cleanup.
Google__ClaimUserId=
Google__ClaimEmail=
Google__ClaimExpiresAt=

# .env.scraper
IDENTITY_MODE=cookie
# Mirror of the API's Identity__AcceptLegacyGuidCookie. Turn both off together:
# the scraper honours a pre-sessions cookie read-only and never mints.
ACCEPT_LEGACY_GUID_COOKIE=true
MONGODB_CONNECTION_STRING=
# MUST match the API's MongoDB__DatabaseName above. In Cookie mode the scraper
# resolves sessions by reading that database's "sessions" collection directly
# (docs/auth.md), so a mismatch means every scraper request 401s -- or, worse,
# resolves against another instance's sessions. Nothing checks this.
MONGODB_DATABASE_NAME=
MongoDB__ProfileDatabase=
OPENAI_API_KEY=

# .env.web
# These are Docker DNS SERVICE NAMES, not URLs to a host. client/nginx.conf
# resolves them at runtime through the Docker resolver, so renaming a compose
# service without editing this file leaves nginx looking up a host that no
# longer exists -- and the symptom is a 200 serving the SPA, not an error.
API_URL=http://api:8080
SCRAPER_URL=http://scraper:8080

# .env.mailbot
Anthropic__ApiKey=
# WHO the mailbot is. The opaque session token, never a userId -- the same rule
# the scraper follows. Required against a Cookie-mode tracker: without it the
# API mints a fresh anonymous user per request, the sync reads an empty account
# and reports success (issue #67). Not needed against a Fixed-mode instance,
# which takes identity from its own configuration.
#
# Provisioned by deploy/mint-mailbot-session.sh, which writes it here. Sessions
# slide on use and the mailbot runs daily, so it renews itself; rotate by
# re-running the script, which deletes the previous session.
Tracker__SessionToken=

# ----------------------------------------------------------------------------
# .env.pool-ingest
#
# The shared pool's daily ingest (docs/scraper-slimming.md, Phase 2). A cron
# container, not a service.
#
# Api__BaseUrl, Scraper__BaseUrl and Roles__ConfigPath live in compose.yml:
# they are Docker DNS service names and a path inside the image, not secrets.

# The same pair as the API. This process writes discovered_jobs and
# discovery_runs and reads pool_roles; it touches nothing user-scoped.
MongoDB__ConnectionString=
MongoDB__Database=job-tracker

# Optional. A shared-secret gate that selects NO user, matching the API's own
# ApiKey when one is set. nextrole.cloud leaves both unset.
#
# There is deliberately no session token here, unlike .env.mailbot. Every call
# this process makes is user-independent, so it acts as nobody -- presenting an
# identity it does not need is how the mailbot ended up writing into a freshly
# minted account (issue #67).
Api__ApiKey=
