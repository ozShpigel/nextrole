# Scraper environment (copy to .env and fill in).
# Minimum to run: MONGODB_CONNECTION_STRING + OPENAI_API_KEY.

# Required
MONGODB_CONNECTION_STRING=<your-mongodb-connection-string>
# OpenAI key for job/profile embeddings (text-embedding-3-small).
OPENAI_API_KEY=<your-openai-api-key>

# Optional (defaults shown)
# MONGODB_DATABASE_NAME=job-tracker
# API_BASE_URL=http://localhost:5002
# CRON_SECRET=
# CORS_ORIGINS=*

# Hosting a public read-only demo? See docs/hosting-a-public-demo.md.
# (Private/local use needs nothing here — DEMO_MODE is off by default.)
